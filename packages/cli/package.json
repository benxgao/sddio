{
  "name": "@sddio/cli",
  "version": "0.2.1",
  "description": "A spec-driven development tool for coding agents: keep SPEC, ADR and DISCUSSION in your repo so the reasoning survives session restarts.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "sddio": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benxgao/sddio.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/benxgao/sddio/tree/master/packages/cli",
  "bugs": {
    "url": "https://github.com/benxgao/sddio/issues"
  },
  "keywords": [
    "sddio",
    "spec-driven-development",
    "spec-driven",
    "coding-agents",
    "ai-agents",
    "context-engineering",
    "claude-code",
    "cursor",
    "agents-md",
    "adr",
    "cli",
    "scaffold"
  ],
  "scripts": {
    "sync": "node scripts/sync-templates.mjs",
    "prebuild": "npm run clean && npm run sync",
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('templates',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
